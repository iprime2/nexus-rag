# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Every variable uses the NEXUS_ prefix; unknown NEXUS_* keys in .env are rejected at startup.
# Real environment variables override values from .env.

# local | test | staging | production
NEXUS_ENVIRONMENT=local

# Must be false in production (enforced at startup).
NEXUS_DEBUG=false

# Serve /docs, /redoc and /openapi.json.
NEXUS_DOCS_ENABLED=true

# DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_LEVEL=INFO

# json (machines: Docker, CloudWatch) | console (humans, local development)
NEXUS_LOG_FORMAT=console

# PostgreSQL (matches the defaults in docker-compose.yml for local development).
NEXUS_POSTGRES_HOST=localhost
NEXUS_POSTGRES_PORT=5432
NEXUS_POSTGRES_DB=nexus
NEXUS_POSTGRES_USER=nexus
# Required. Local-only value; real environments inject it from a secret manager.
NEXUS_POSTGRES_PASSWORD=nexus-local-only
# Connection pool per process. Keep processes x (pool + overflow) under Postgres max_connections.
NEXUS_DB_POOL_SIZE=5
NEXUS_DB_MAX_OVERFLOW=5
NEXUS_DB_POOL_TIMEOUT_SECONDS=10

# Redis (no password locally; managed Redis in AWS uses one).
NEXUS_REDIS_HOST=localhost
NEXUS_REDIS_PORT=6379
NEXUS_REDIS_DB=0
NEXUS_REDIS_PASSWORD=

# Qdrant (no API key locally).
NEXUS_QDRANT_URL=http://localhost:6333
NEXUS_QDRANT_API_KEY=

# S3-compatible object storage (local SeaweedFS from docker-compose.yml).
# On AWS: leave endpoint and keys empty, so boto3 uses real S3 and the IAM role.
NEXUS_S3_ENDPOINT_URL=http://localhost:8333
NEXUS_S3_REGION=us-east-1
NEXUS_S3_BUCKET=nexus-documents
NEXUS_S3_ACCESS_KEY_ID=nexus-local
NEXUS_S3_SECRET_ACCESS_KEY=nexus-local-only-secret

# Seconds each dependency check in /health/ready may take.
NEXUS_READINESS_TIMEOUT_SECONDS=2
