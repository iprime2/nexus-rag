# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Every variable uses the NEXUS_ prefix; unknown NEXUS_* keys in .env are rejected at startup.
# Real environment variables override values from .env.

# local | test | staging | production
NEXUS_ENVIRONMENT=local

# Must be false in production (enforced at startup).
NEXUS_DEBUG=false

# Serve /docs, /redoc and /openapi.json.
NEXUS_DOCS_ENABLED=true
