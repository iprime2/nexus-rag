# Keep the build context small and never send secrets or local state to the builder.
.git
.github
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Secrets and local config must never be baked into an image.
.env
.env.*
!.env.example

# Not needed at runtime.
docs
tests
infrastructure
*.md
!README.md
docker-compose.yml
Dockerfile
.pre-commit-config.yaml
